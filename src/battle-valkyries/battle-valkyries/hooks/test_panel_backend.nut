::$bvvar{namespace}.grantTestPanelEquipment <- function( _action )
{
	local ns = ::$bvvar{namespace};
	if (!ns.isTestPanelOriginAvailable()) return ns.makeTestPanelResult(false, "origin", "$bv{ui.test_panel.error.origin}");
	local paths = [], count = 10, named = true;
	foreach (entry in ns.getTestPanelEquipmentCatalog())
		if (entry.ID == _action) { paths.push(entry.Path); break; }
	if (_action == "equipment_legendary_weapons")
	{
		paths = ["weapons/legendary/lightbringer_sword", "weapons/legendary/miasma_flail", "weapons/legendary/obsidian_dagger"];
		count = 1; named = false;
	}
	if (_action == "equipment_legendary_other")
	{
		paths = ["accessory/legendary/cursed_crystal_skull", "ammo/legendary/quiver_of_coated_arrows",
			"armor/legendary/armor_of_davkul", "armor/legendary/emperors_armor", "armor/legendary/ijirok_armor",
			"helmets/legendary/emperors_countenance", "helmets/legendary/fangshire", "helmets/legendary/ijirok_helmet",
			"helmets/legendary/mask_of_davkul", "shields/legendary/gilders_embrace_shield"];
		count = 1; named = false;
	}
	if (_action == "equipment_ammo")
	{
		paths = ["ammo/large_quiver_of_arrows", "ammo/large_quiver_of_bolts", "ammo/large_powder_bag"];
		named = false;
	}
	if (paths.len() == 0) return ns.makeTestPanelResult(false, "invalid", "$bv{ui.test_panel.error.invalid}");
	local stash = ::World.Assets.getStash();
	if (stash == null) return ns.makeTestPanelResult(false, "stash", "$bv{ui.test_panel.error.stash}");
	local pending = [];
	try
	{
		local capacity = ::Math.max(stash.getCapacity(), ::Math.max(stash.getItems().len(), stash.getNumberOfFilledSlots() + paths.len() * count));
		if (capacity > 65535) return ns.makeTestPanelResult(false, "capacity", "$bv{ui.test_panel.error.stash_capacity}");
		foreach (path in paths)
			for (local i = 0; i < count; ++i)
			{
				// Reuse the host-aware factory so Legends armor retains all of its layers.
				local item = ns.createExpandedEnemyEquipment(path);
				if (item == null || (named && !item.isItemType(::Const.Items.ItemType.Named))) throw "Expected famed equipment: " + path;
				if (!named && _action != "equipment_ammo" && !item.isItemType(::Const.Items.ItemType.Legendary)) throw "Expected legendary equipment: " + path;
				pending.push(item);
			}
		if (capacity > stash.getCapacity()) stash.resize(capacity);
		foreach (item in pending) if (stash.add(item) == null) throw "Stash rejected test equipment";
	}
	catch (e)
	{
		// Remove only this request's instances, including insertion before a failing callback.
		foreach (item in pending) stash.remove(item);
		::logWarning("[Battle Valkyries] Test panel could not supply equipment: " + e);
		return ns.makeTestPanelResult(false, "equipment", "$bv{ui.test_panel.error.equipment}");
	}
	ns.refreshTestPanelWorldAssets();
	return ns.makeTestPanelResult(true, "ok", format("$bv{ui.test_panel.success.equipment}", pending.len()));
};

::$bvvar{namespace}.isTestPanelOriginAvailable <- function()
{
	if (!(("World" in getroottable())) || ::World == null || ::World.Assets == null)
	{
		return false;
	}

	try
	{
		local origin = ::World.Assets.getOrigin();
		return origin != null && origin.getID() == "$bvvar{scenarioId}";
	}
	catch (e)
	{
		return false;
	}
};

::$bvvar{namespace}.getTestPanelAlchemySystem <- function()
{
	local root = getroottable();
	if ("AlchemyEnchantmentSystem" in root) return ::AlchemyEnchantmentSystem;
	if ("AlchemyEnchantmentSystemZh" in root) return ::AlchemyEnchantmentSystemZh;
	return null;
};

::$bvvar{namespace}.canGrantTestPanelAlchemyResources <- function()
{
	local alchemy = ::$bvvar{namespace}.getTestPanelAlchemySystem();
	local researchAPI = ::$bvvar{namespace}.getTheHertaResearchAPI();
	return researchAPI != null
		&& "isEnabled" in researchAPI
		&& researchAPI.isEnabled()
		&& alchemy != null
		&& "EquipmentAffixTierOrder" in alchemy
		&& "addEquipmentMaterial" in alchemy
		&& "addEquipmentRemovalStone" in alchemy;
};

::$bvvar{namespace}.makeTestPanelAction <- function( _id, _label, _description, _group, _enabled = true, _disabledReason = "" )
{
	return {
		ID = _id,
		Label = _label,
		Description = _description,
		Group = _group,
		Enabled = _enabled,
		DisabledReason = _disabledReason
	};
};

::$bvvar{namespace}.queryTestPanelData <- function()
{
	if (!::$bvvar{namespace}.isTestPanelOriginAvailable()) return { Available = false };

	local hasSwordMaiden = ::$bvvar{namespace}.findValkyrieInRoster("sword_maiden") != null;
	local hasLily = ::$bvvar{namespace}.findValkyrieInRoster("lily") != null;
	local hertaAvailable = ::$bvvar{namespace}.isTheHertaResearchAvailable();
	local alchemyAvailable = ::$bvvar{namespace}.canGrantTestPanelAlchemyResources();
	local chaptersAvailable = "ChapterDefinitions" in ::$bvvar{namespace} && ::$bvvar{namespace}.ChapterDefinitions.len() > 0;
	local ryzaAvailable = "RyzaMaterials" in ::$bvvar{namespace} && ::$bvvar{namespace}.RyzaMaterials.len() > 0;
	local needsSwordMaiden = hasSwordMaiden ? "" : "$bv{ui.test_panel.require.sword_maiden}";
	local needsLily = hasLily ? "" : "$bv{ui.test_panel.require.lily}";
	local needsHerta = hertaAvailable ? "" : "$bv{ui.test_panel.require.the_herta}";
	local needsAlchemy = alchemyAvailable ? "" : "$bv{ui.test_panel.require.alchemy}";
	local enemyActions = [];
	enemyActions.push(::$bvvar{namespace}.makeTestPanelAction("enemy_ordinary_bandits", "$bv{ui.test_panel.action.ordinary_bandits}", "$bv{ui.test_panel.action.ordinary_bandits.description}", "enemies"));
	enemyActions.push(::$bvvar{namespace}.makeTestPanelAction("enemy_all", "$bv{enemy_expansion.test.all_action}", "$bv{enemy_expansion.test.all_description}", "enemies"));
	local naturalBlock = ::$bvvar{namespace}.getEnemySpawnTestSetupBlock();
	local banditContractBlock = ::$bvvar{namespace}.getBanditTestContractBlock();
	foreach (group in ::$bvvar{namespace}.ExpandedEnemyGroups)
		enemyActions.push(::$bvvar{namespace}.makeTestPanelAction("enemy_" + group.ID, group.Action, "$bv{enemy_expansion.test.description}", "enemies"));

	local data = {
		Available = true,
		Button = "$bv{ui.test_panel.button}",
		Title = "$bv{ui.test_panel.title}",
		Subtitle = "$bv{ui.test_panel.subtitle}",
		Close = "$bv{ui.test_panel.close}",
		Ready = "$bv{ui.test_panel.ready}",
		Busy = "$bv{ui.test_panel.busy}",
		ScrollLabel = "$bv{ui.test_panel.scroll}",
		NaturalStatus = ::$bvvar{namespace}.getEnemySpawnTestStatus(),
		NaturalHelp = "$bv{ui.test_panel.natural.help}",
		EquipmentPick = "$bv{ui.test_panel.equipment.pick}",
		EquipmentGrant = "$bv{ui.test_panel.equipment.grant}",
		Groups = {
			shields = "$bv{ui.test_panel.group.shields}",
			helmets = "$bv{ui.test_panel.group.helmets}",
			armor = "$bv{ui.test_panel.group.armor}",
			weapons = "$bv{ui.test_panel.group.weapons}",
			natural = "$bv{ui.test_panel.group.natural}",
			economy = "$bv{ui.test_panel.group.economy}",
			progress = "$bv{ui.test_panel.group.progress}",
			items = "$bv{ui.test_panel.group.items}",
			enemies = "$bv{ui.test_panel.group.enemies}"
		},
		Actions = [
			::$bvvar{namespace}.makeTestPanelAction("equipment_legendary_weapons", "$bv{ui.test_panel.action.equipment_legendary_weapons}", "$bv{ui.test_panel.action.equipment_legendary_weapons.description}", "items"),
			::$bvvar{namespace}.makeTestPanelAction("equipment_legendary_other", "$bv{ui.test_panel.action.equipment_legendary_other}", "$bv{ui.test_panel.action.equipment_legendary_other.description}", "items"),
			::$bvvar{namespace}.makeTestPanelAction("equipment_ammo", "$bv{ui.test_panel.action.equipment_ammo}", "$bv{ui.test_panel.action.equipment_ammo.description}", "items"),
			::$bvvar{namespace}.makeTestPanelAction("prepare_natural", "$bv{ui.test_panel.action.prepare_natural}", "$bv{ui.test_panel.action.prepare_natural.description}", "natural", naturalBlock == "", naturalBlock),
			::$bvvar{namespace}.makeTestPanelAction("bandit_contract", "$bv{ui.test_panel.action.bandit_contract}", "$bv{ui.test_panel.action.bandit_contract.description}", "natural", banditContractBlock == "", banditContractBlock),
			::$bvvar{namespace}.makeTestPanelAction("money", "$bv{ui.test_panel.action.money}", "$bv{ui.test_panel.action.money.description}", "economy"),
			::$bvvar{namespace}.makeTestPanelAction("renown", "$bv{ui.test_panel.action.renown}", "$bv{ui.test_panel.action.renown.description}", "economy"),
			::$bvvar{namespace}.makeTestPanelAction("stash_slots", "$bv{ui.test_panel.action.stash_slots}", "$bv{ui.test_panel.action.stash_slots.description}", "economy"),
			::$bvvar{namespace}.makeTestPanelAction("stones", "$bv{ui.test_panel.action.stones}", "$bv{ui.test_panel.action.stones.description}", "economy", alchemyAvailable, needsAlchemy),
			::$bvvar{namespace}.makeTestPanelAction("sword_maiden", "$bv{ui.test_panel.action.sword_maiden}", "$bv{ui.test_panel.action.sword_maiden.description}", "progress", hasSwordMaiden, needsSwordMaiden),
			::$bvvar{namespace}.makeTestPanelAction("the_herta", "$bv{ui.test_panel.action.the_herta}", "$bv{ui.test_panel.action.the_herta.description}", "progress", hertaAvailable, needsHerta),
			::$bvvar{namespace}.makeTestPanelAction("lily", "$bv{ui.test_panel.action.lily}", "$bv{ui.test_panel.action.lily.description}", "progress", hasLily, needsLily),
			::$bvvar{namespace}.makeTestPanelAction("black_beast", "$bv{ui.test_panel.action.black_beast}", "$bv{ui.test_panel.action.black_beast.description}", "progress"),
			::$bvvar{namespace}.makeTestPanelAction("orbment_gems", "$bv{ui.test_panel.action.orbment_gems}", "$bv{ui.test_panel.action.orbment_gems.description}", "items"),
			::$bvvar{namespace}.makeTestPanelAction("bond_items", "$bv{ui.test_panel.action.bond_items}", "$bv{ui.test_panel.action.bond_items.description}", "items"),
			::$bvvar{namespace}.makeTestPanelAction("tenka_goken_weapons", "$bv{ui.test_panel.action.tenka_goken_weapons}", "$bv{ui.test_panel.action.tenka_goken_weapons.description}", "items"),
			::$bvvar{namespace}.makeTestPanelAction("chapter_materials", "$bv{ui.test_panel.action.chapter_materials}", "$bv{ui.test_panel.action.chapter_materials.description}", "items", chaptersAvailable, chaptersAvailable ? "" : "$bv{ui.test_panel.require.chapters}"),
			::$bvvar{namespace}.makeTestPanelAction("ryza_materials", "$bv{ui.test_panel.action.ryza_materials}", "$bv{ui.test_panel.action.ryza_materials.description}", "items", ryzaAvailable, ryzaAvailable ? "" : "$bv{ui.test_panel.require.ryza_materials}"),
			::$bvvar{namespace}.makeTestPanelAction("level_items", "$bv{ui.test_panel.action.level_items}", "$bv{ui.test_panel.action.level_items.description}", "items"),
			::$bvvar{namespace}.makeTestPanelAction("perk_items", "$bv{ui.test_panel.action.perk_items}", "$bv{ui.test_panel.action.perk_items.description}", "items")
		]
	};
	foreach (entry in ::$bvvar{namespace}.getTestPanelEquipmentCatalog())
		data.Actions.push(::$bvvar{namespace}.makeTestPanelAction(entry.ID, entry.Label, "$bv{ui.test_panel.equipment.description}", entry.Group));
	data.Actions.extend(enemyActions);
	return data;
};

::$bvvar{namespace}.makeTestPanelResult <- function( _success, _code, _message )
{
	return { Success = _success, Code = _code, Message = _message };
};

::$bvvar{namespace}.refreshTestPanelWorldAssets <- function()
{
	try { if (::World.State != null) ::World.State.updateTopbarAssets(); } catch (e) {}
};

::$bvvar{namespace}.grantTestPanelItems <- function( _script, _count )
{
	local stash = ::World.Assets.getStash();
	if (stash == null) return 0;
	local requiredCapacity = stash.getNumberOfFilledSlots() + _count;
	if (stash.getCapacity() < requiredCapacity) stash.resize(requiredCapacity);

	local added = 0;
	for (local i = 0; i < _count; ++i)
	{
		try
		{
			if (stash.add(::new(_script)) != null) ++added;
		}
		catch (e)
		{
			::logWarning("[Battle Valkyries] Test panel could not add item " + _script + ": " + e);
		}
	}
	return added;
};

::$bvvar{namespace}.grantTestPanelTenkaGokenWeapons <- function()
{
	local ns = ::$bvvar{namespace};
	if (!ns.isTestPanelOriginAvailable()) return ns.makeTestPanelResult(false, "origin", "$bv{ui.test_panel.error.origin}");
	local stash = ::World.Assets.getStash();
	if (stash == null) return ns.makeTestPanelResult(false, "stash", "$bv{ui.test_panel.error.stash}");
	local pending = [];
	try
	{
		local capacity = ::Math.max(stash.getCapacity(), ::Math.max(stash.getItems().len(), stash.getNumberOfFilledSlots() + 5));
		if (capacity > 65535) return ns.makeTestPanelResult(false, "capacity", "$bv{ui.test_panel.error.stash_capacity}");
		// Use the existing legendary weapons, without changing festival progress or rewards.
		foreach (key in ["onimaru_aun", "odenta_rose", "juzumaru_changes", "dojigiri_dance", "mikazuki_unyo"])
		{
			local item = ::new("scripts/items/weapons/battle_valkyries/" + key);
			if (item == null || item.getID() != "$bvvar{modId}.weapon." + key) throw "Unexpected Tenka Goken weapon: " + key;
			pending.push(item);
		}
		if (capacity > stash.getCapacity()) stash.resize(capacity);
		foreach (item in pending) if (stash.add(item) == null) throw "Stash rejected a Tenka Goken weapon";
	}
	catch (e)
	{
		// Include items whose onAddedToStash callback threw after insertion. Remove by
		// instance, so previously owned copies of the same swords remain untouched.
		foreach (item in pending) stash.remove(item);
		::logWarning("[Battle Valkyries] Test panel could not supply Tenka Goken weapons: " + e);
		return ns.makeTestPanelResult(false, "weapons", "$bv{ui.test_panel.error.tenka_goken_weapons}");
	}
	ns.refreshTestPanelWorldAssets();
	return ns.makeTestPanelResult(true, "ok", "$bv{ui.test_panel.success.tenka_goken_weapons}");
};

::$bvvar{namespace}.grantTestPanelOrbmentGems <- function()
{
	local ns = ::$bvvar{namespace};
	if (!ns.isTestPanelOriginAvailable()) return ns.makeTestPanelResult(false, "origin", "$bv{ui.test_panel.error.origin}");
	local stash = ::World.Assets.getStash();
	if (stash == null) return ns.makeTestPanelResult(false, "stash", "$bv{ui.test_panel.error.stash}");
	local pending = [];
	try
	{
		local capacity = ::Math.max(stash.getCapacity(), ::Math.max(stash.getItems().len(), stash.getNumberOfFilledSlots() + ns.OrbmentGemOrder.len() * 100));
		if (capacity > 65535) return ns.makeTestPanelResult(false, "capacity", "$bv{ui.test_panel.error.stash_capacity}");
		foreach (key in ns.OrbmentGemOrder)
			for (local rank = 1; rank <= 2; ++rank)
				for (local i = 0; i < 50; ++i)
				{
					local item = ::new("scripts/items/misc/battle_valkyries/orbment_quartz_item");
					item.configure(key + ":" + rank);
					if (item.getID() != "$bvvar{modId}.quartz." + key + "." + rank) throw "Unexpected orbment gem: " + key;
					pending.push(item);
				}
		if (capacity > stash.getCapacity()) stash.resize(capacity);
		foreach (item in pending) if (stash.add(item) == null) throw "Stash rejected a orbment gem";
	}
	catch (e)
	{
		// Include items whose onAddedToStash callback threw after insertion. Remove by
		// instance, so previously owned copies of the same gems remain untouched.
		foreach (item in pending) stash.remove(item);
		::logWarning("[Battle Valkyries] Test panel could not supply orbment gems: " + e);
		return ns.makeTestPanelResult(false, "gems", "$bv{ui.test_panel.error.orbment_gems}");
	}
	ns.refreshTestPanelWorldAssets();
	return ns.makeTestPanelResult(true, "ok", "$bv{ui.test_panel.success.orbment_gems}");
};

::$bvvar{namespace}.grantTestPanelChapterMaterials <- function()
{
	if (!("ChapterDefinitions" in ::$bvvar{namespace}) || ::$bvvar{namespace}.ChapterDefinitions.len() == 0)
		return ::$bvvar{namespace}.makeTestPanelResult(false, "chapters", "$bv{ui.test_panel.require.chapters}");

	local stash = ::World.Assets.getStash();
	if (stash == null) return ::$bvvar{namespace}.makeTestPanelResult(false, "stash", "$bv{ui.test_panel.error.stash}");
	try
	{
		// Read the live material definitions, including unopened chapters and optional
		// SourceGoal supplies. Grant their physical alternative without completing the
		// collection action; Evidence and investigation flags remain chapter-owned.
		local requirements = {}, owned = {}, pending = [], resources = { medicine = 0, tools = 0 };
		foreach (id, chapter in ::$bvvar{namespace}.ChapterDefinitions)
			foreach (stage in chapter.Stages)
				foreach (material in stage.Materials)
				{
					// Match Chapters.inventoryCount: these keys are campaign resources, not stash items.
					if (material.Key in resources)
					{
						resources[material.Key] += material.Count;
						continue;
					}
					if (!("Item" in material) || !("Script" in material)) throw "Missing chapter material Item/Script: " + material.Key;
					if (!(material.Item in requirements)) requirements[material.Item] <- { Script = material.Script, Count = 0 };
					if (requirements[material.Item].Script != material.Script) throw "Conflicting chapter material scripts: " + material.Item;
					requirements[material.Item].Count += material.Count;
				}
		foreach (item in stash.getItems())
			if (item != null)
			{
				local id = item.getID();
				if (!(id in owned)) owned[id] <- 0;
				++owned[id];
			}
		// Resolve every item before changing the stash; a bad script must not grant a partial bundle.
		foreach (id, requirement in requirements)
			for (local i = id in owned ? owned[id] : 0; i < requirement.Count; ++i)
			{
				local item = ::new(requirement.Script);
				if (item == null || item.getID() != id) throw "Chapter material script returned a different item: " + requirement.Script;
				pending.push(item);
			}
		local requiredCapacity = ::Math.max(stash.getCapacity(), ::Math.max(stash.getItems().len(), stash.getNumberOfFilledSlots() + pending.len()));
		// Vanilla serializes stash size and capacity as U16.
		if (requiredCapacity > 65535) return ::$bvvar{namespace}.makeTestPanelResult(false, "capacity", "$bv{ui.test_panel.error.stash_capacity}");
		if (requiredCapacity > stash.getCapacity()) stash.resize(requiredCapacity);
		foreach (item in pending) if (stash.add(item) == null) throw "Stash rejected a chapter material";
		local assets = ::World.Assets, oldMedicine = assets.getMedicine(), oldTools = assets.getArmorParts();
		// Keep host resource caps and existing surplus; retries only replenish the deficit.
		if (resources.medicine > oldMedicine) assets.setMedicine(resources.medicine);
		if (resources.tools > oldTools) assets.setArmorParts(resources.tools);
		::$bvvar{namespace}.refreshTestPanelWorldAssets();
		return ::$bvvar{namespace}.makeTestPanelResult(true, "ok", format("$bv{ui.test_panel.success.chapter_materials}", pending.len(), (assets.getMedicine() - oldMedicine).tointeger(), (assets.getArmorParts() - oldTools).tointeger()));
	}
	catch (e)
	{
		::logWarning("[Battle Valkyries] Test panel could not supply chapter materials: " + e);
		return ::$bvvar{namespace}.makeTestPanelResult(false, "materials", "$bv{ui.test_panel.error.chapter_materials}");
	}
};

::$bvvar{namespace}.grantTestPanelRyzaMaterials <- function()
{
	if (!("RyzaMaterials" in ::$bvvar{namespace}) || ::$bvvar{namespace}.RyzaMaterials.len() == 0)
		return ::$bvvar{namespace}.makeTestPanelResult(false, "ryza", "$bv{ui.test_panel.require.ryza_materials}");
	local stash = ::World.Assets.getStash();
	if (stash == null) return ::$bvvar{namespace}.makeTestPanelResult(false, "stash", "$bv{ui.test_panel.error.stash}");
	try
	{
		local requirements = [], owned = {}, pending = [], missing = 0;
		// Legends keeps separate IDs; Accessory Companions may normalize them back
		// to vanilla IDs. Count and validate both forms as the same basic pet.
		local petAliases = {
			["accessory.legend_wardog"] = "accessory.wardog",
			["accessory.legend_warhound"] = "accessory.warhound",
			["accessory.legend_warwolf"] = "accessory.warwolf"
		};
		// Ryza's material keys match the vanilla misc script basenames.
		foreach (key, material in ::$bvvar{namespace}.RyzaMaterials)
			requirements.push({ ID = material.ID, Script = "scripts/items/misc/" + key + "_item", Count = 100 });
		// The wolf's script name differs from its persistent item ID.
		foreach (pet in ["wardog", "warhound", "wolf", "falcon"])
		{
			// AC initializes canine type/stats only for these supported Legends subclasses.
			local prefix = pet != "falcon" && "Legends" in getroottable() ? "legend_" : "";
			requirements.push({ ID = "accessory." + (pet == "wolf" ? "warwolf" : pet), Script = "scripts/items/accessory/" + prefix + pet + "_item", Count = 20 });
		}
		foreach (item in stash.getItems())
			if (item != null)
			{
				local id = item.getID();
				if (id in petAliases) id = petAliases[id];
				if (!(id in owned)) owned[id] <- 0;
				++owned[id];
			}
		// Top up only the deficit, preserving surplus and making retries safe.
		foreach (requirement in requirements)
			missing += ::Math.max(0, requirement.Count - (requirement.ID in owned ? owned[requirement.ID] : 0));
		local capacity = ::Math.max(stash.getCapacity(), ::Math.max(stash.getItems().len(), stash.getNumberOfFilledSlots() + missing));
		if (capacity > 65535) return ::$bvvar{namespace}.makeTestPanelResult(false, "capacity", "$bv{ui.test_panel.error.stash_capacity}");
		// Resolve and validate every item before expanding or adding to the stash.
		foreach (requirement in requirements)
			for (local i = requirement.ID in owned ? owned[requirement.ID] : 0; i < requirement.Count; ++i)
			{
				local item = ::new(requirement.Script);
				local id = item == null ? "null" : item.getID();
				if (id in petAliases) id = petAliases[id];
				if (id != requirement.ID) throw "Unexpected Ryza material item: " + requirement.Script + ", expected " + requirement.ID + ", got " + (item == null ? "null" : item.getID());
				pending.push(item);
			}
		if (capacity > stash.getCapacity()) stash.resize(capacity);
		foreach (item in pending) if (stash.add(item) == null) throw "Stash rejected a Ryza material";
		::$bvvar{namespace}.refreshTestPanelWorldAssets();
		return ::$bvvar{namespace}.makeTestPanelResult(true, "ok", format("$bv{ui.test_panel.success.ryza_materials}", pending.len()));
	}
	catch (e)
	{
		::logWarning("[Battle Valkyries] Test panel could not supply Ryza materials: " + e);
		return ::$bvvar{namespace}.makeTestPanelResult(false, "materials", "$bv{ui.test_panel.error.ryza_materials}");
	}
};

::$bvvar{namespace}.grantTestPanelBlackBeast <- function()
{
	local ns = ::$bvvar{namespace};
	if (!ns.isTestPanelOriginAvailable()) return ns.makeTestPanelResult(false, "origin", "$bv{ui.test_panel.error.origin}");
	if (::World.State == null || ::World.State.getPlayer() == null || ::World.getPlayerRoster() == null
		|| ::World.State.getCombatStartTime() != 0)
		return ns.makeTestPanelResult(false, "world", "$bv{ui.test_panel.natural.require.world}");

	local missing = [];
	foreach (id in ["olga", "chloe", "alicia", "prim", "kaguya", "maia", "luu_luu", "claudia", "celestine"])
	{
		if (ns.findValkyrieInRoster(id) != null) continue;
		if (ns.getValkyrieByID(id) == null)
			return ns.makeTestPanelResult(false, "template", "$bv{ui.test_panel.error.black_beast}");
		missing.push(id);
	}
	local roster = ::World.getPlayerRoster();
	if (missing.len() > 0 && roster.getSize() + missing.len() > ns.getValkyrieEffectiveRosterMax())
		return ns.makeTestPanelResult(false, "roster", format("$bv{ui.test_panel.require.black_beast_roster}", missing.len()));

	local created = [];
	try
	{
		// Test-only recruitment bypasses chapter eligibility, but keeps the shared
		// identity, skin, managed-skill and formation initialization path.
		foreach (id in missing)
		{
			local result = ns.createValkyrieRosterActor(id, ::World.State, { HireReason = "test-black-beast" });
			if (!result.Success) throw "recruit " + id + ": " + result.Code + ("Detail" in result ? " " + result.Detail : "");
			created.push(result.Actor);
			ns.equipBlackBeastStarter(result.Actor, id, ::World.State);
		}
	}
	catch (e)
	{
		// The shared constructor cleans up its failed actor; undo earlier recruits.
		foreach (actor in created) roster.remove(actor);
		try { ::World.State.getPlayer().updateStrength(); } catch (refreshError) {}
		::logWarning("[Battle Valkyries] Test panel could not recruit Black Beast characters: " + e);
		return ns.makeTestPanelResult(false, "recruit", "$bv{ui.test_panel.error.black_beast}");
	}
	ns.refreshTestPanelWorldAssets();
	return ns.makeTestPanelResult(true, "ok", format("$bv{ui.test_panel.success.black_beast}", created.len(), 9 - missing.len()));
};

::$bvvar{namespace}.executeTestPanelAction <- function( _request )
{
	if (!::$bvvar{namespace}.isTestPanelOriginAvailable())
	{
		return ::$bvvar{namespace}.makeTestPanelResult(false, "origin", "$bv{ui.test_panel.error.origin}");
	}
	if (typeof _request != "table" || !("Action" in _request) || typeof _request.Action != "string")
	{
		return ::$bvvar{namespace}.makeTestPanelResult(false, "invalid", "$bv{ui.test_panel.error.invalid}");
	}

	local action = _request.Action;
	if (action.find("equipment_") == 0) return ::$bvvar{namespace}.grantTestPanelEquipment(action);
	if (action == "orbment_gems") return ::$bvvar{namespace}.grantTestPanelOrbmentGems();
	if (action == "tenka_goken_weapons") return ::$bvvar{namespace}.grantTestPanelTenkaGokenWeapons();
	if (action == "black_beast") return ::$bvvar{namespace}.grantTestPanelBlackBeast();
	if (action == "chapter_materials") return ::$bvvar{namespace}.grantTestPanelChapterMaterials();
	if (action == "ryza_materials") return ::$bvvar{namespace}.grantTestPanelRyzaMaterials();
	if (action == "stash_slots")
	{
		local stash = ::World.Assets.getStash();
		if (stash == null) return ::$bvvar{namespace}.makeTestPanelResult(false, "stash", "$bv{ui.test_panel.error.stash}");
		local capacity = ::Math.max(stash.getCapacity(), stash.getItems().len());
		if (capacity > 65535 - 100) return ::$bvvar{namespace}.makeTestPanelResult(false, "capacity", "$bv{ui.test_panel.error.stash_capacity}");
		stash.resize(capacity + 100);
		::$bvvar{namespace}.refreshTestPanelWorldAssets();
		return ::$bvvar{namespace}.makeTestPanelResult(true, "ok", format("$bv{ui.test_panel.success.stash_slots}", stash.getCapacity()));
	}
	if (action == "prepare_natural") return ::$bvvar{namespace}.prepareEnemySpawnTest();
	if (action == "bandit_contract") return ::$bvvar{namespace}.createBanditTestContract();
	if (action == "enemy_all") return ::$bvvar{namespace}.spawnExpandedEnemyTestParty("all");
	if (action == "enemy_ordinary_bandits") return ::$bvvar{namespace}.spawnExpandedEnemyTestParty("ordinary_bandits");
	foreach (group in ::$bvvar{namespace}.ExpandedEnemyGroups)
		if (action == "enemy_" + group.ID) return ::$bvvar{namespace}.spawnExpandedEnemyTestParty(group.ID);
	if (action == "money")
	{
		::World.Assets.addMoney(1000000);
		::$bvvar{namespace}.refreshTestPanelWorldAssets();
		return ::$bvvar{namespace}.makeTestPanelResult(true, "ok", "$bv{ui.test_panel.success.money}");
	}
	if (action == "renown")
	{
		::World.Assets.addBusinessReputation(100000);
		::$bvvar{namespace}.refreshTestPanelWorldAssets();
		return ::$bvvar{namespace}.makeTestPanelResult(true, "ok", "$bv{ui.test_panel.success.renown}");
	}
	if (action == "stones")
	{
		if (!::$bvvar{namespace}.canGrantTestPanelAlchemyResources())
		{
			return ::$bvvar{namespace}.makeTestPanelResult(false, "alchemy", "$bv{ui.test_panel.require.alchemy}");
		}
		local alchemy = ::$bvvar{namespace}.getTestPanelAlchemySystem();
		local success = true;
		foreach (tierID in alchemy.EquipmentAffixTierOrder)
		{
			if (!alchemy.addEquipmentMaterial(tierID, 1000)) success = false;
		}
		if (!alchemy.addEquipmentRemovalStone(1000)) success = false;
		return ::$bvvar{namespace}.makeTestPanelResult(success, success ? "ok" : "alchemy", success ? "$bv{ui.test_panel.success.stones}" : "$bv{ui.test_panel.error.alchemy}");
	}
	if (action == "sword_maiden")
	{
		local actor = ::$bvvar{namespace}.findValkyrieInRoster("sword_maiden");
		local trait = ::$bvvar{namespace}.getSwordMaidenHuntTrait(actor);
		if (actor == null || trait == null)
		{
			return ::$bvvar{namespace}.makeTestPanelResult(false, "actor", "$bv{ui.test_panel.require.sword_maiden}");
		}
		trait.m.TotalPoints = 300;
		trait.m.PendingPoints = 0;
		trait.m.PendingDirectKills = 0;
		trait.m.PendingAssistConvictions = 0;
		trait.m.PendingKillCounts = trait.makeCounts();
		trait.m.CombatCredits = {};
		local sync = ::$bvvar{namespace}.syncActorSkills(actor, "test-panel-sword-maiden-max");
		actor.getSkills().update();
		actor.setDirty(true);
		local syncSuccess = sync != null && "Success" in sync && sync.Success;
		local syncCode = sync != null && "Code" in sync ? sync.Code : "refresh";
		return ::$bvvar{namespace}.makeTestPanelResult(syncSuccess, syncSuccess ? "ok" : syncCode, syncSuccess ? "$bv{ui.test_panel.success.sword_maiden}" : "$bv{ui.test_panel.error.refresh}");
	}
	if (action == "the_herta")
	{
		if (!::$bvvar{namespace}.isTheHertaResearchAvailable())
		{
			return ::$bvvar{namespace}.makeTestPanelResult(false, "actor", "$bv{ui.test_panel.require.the_herta}");
		}
		local day = 0;
		try { day = ::World.getTime().Days; } catch (e) {}
		::$bvvar{namespace}.setTheHertaResearchWorldInt("initialized", 1);
		foreach (id, rule in ::$bvvar{namespace}.TheHertaResearchQuotaRules)
		{
			::$bvvar{namespace}.setTheHertaResearchWorldInt(id + ".charges", rule.Max);
			::$bvvar{namespace}.setTheHertaResearchWorldInt(id + ".anchor", day);
		}
		return ::$bvvar{namespace}.makeTestPanelResult(true, "ok", "$bv{ui.test_panel.success.the_herta}");
	}
	if (action == "lily")
	{
		local actor = ::$bvvar{namespace}.findValkyrieInRoster("lily");
		local record = ::$bvvar{namespace}.getLilySpiritRecord(actor);
		if (actor == null || record == null)
		{
			return ::$bvvar{namespace}.makeTestPanelResult(false, "actor", "$bv{ui.test_panel.require.lily}");
		}
		record.m.PurificationPoints = 310;
		record.m.PendingPoints = 0;
		record.m.CombatCredits = {};
		record.rebuildUnlockedMask();
		actor.getSkills().update();
		actor.setDirty(true);
		return ::$bvvar{namespace}.makeTestPanelResult(true, "ok", "$bv{ui.test_panel.success.lily}");
	}

	local itemScript = null;
	if (action == "bond_items") itemScript = "scripts/items/misc/battle_valkyries/memory_bond_keepsake_item";
	else if (action == "level_items") itemScript = "scripts/items/misc/battle_valkyries/memory_level_keepsake_item";
	else if (action == "perk_items") itemScript = "scripts/items/misc/battle_valkyries/memory_perk_keepsake_item";
	if (itemScript != null)
	{
		local added = ::$bvvar{namespace}.grantTestPanelItems(itemScript, 10);
		if (added != 10) return ::$bvvar{namespace}.makeTestPanelResult(false, "stash", "$bv{ui.test_panel.error.stash}");
		if (action == "bond_items") return ::$bvvar{namespace}.makeTestPanelResult(true, "ok", "$bv{ui.test_panel.success.bond_items}");
		if (action == "level_items") return ::$bvvar{namespace}.makeTestPanelResult(true, "ok", "$bv{ui.test_panel.success.level_items}");
		return ::$bvvar{namespace}.makeTestPanelResult(true, "ok", "$bv{ui.test_panel.success.perk_items}");
	}

	return ::$bvvar{namespace}.makeTestPanelResult(false, "invalid", "$bv{ui.test_panel.error.invalid}");
};

::$bvvar{namespace}.MH.hook("scripts/ui/screens/world/modules/topbar/world_screen_topbar_options_module", function(q) {
	q.queryBattleValkyriesTestPanel <- function()
	{
		return ::$bvvar{namespace}.queryTestPanelData();
	}

	q.executeBattleValkyriesTestAction <- function( _request )
	{
		local result = ::$bvvar{namespace}.executeTestPanelAction(_request);
		local actionID = typeof _request == "table" && "Action" in _request && typeof _request.Action == "string" ? _request.Action : "invalid";
		::logInfo("[Battle Valkyries] Test panel action=" + actionID + " success=" + result.Success + " code=" + result.Code);
		return result;
	}
});
