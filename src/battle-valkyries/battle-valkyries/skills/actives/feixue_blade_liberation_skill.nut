this.feixue_blade_liberation_skill <- this.inherit("$bvvar{privateFolder}/skills/core/valkyrie_active_skill", {
	function create(){this.valkyrie_active_skill.create();this.m.IsTargeted=false;this.m.IsTargetingActor=false;this.m.IsAttack=false;this.m.IsWeaponSkill=false;this.m.IsRanged=false;this.m.ActionPointCost=5;this.m.FatigueCost=30;}
	function owner(){local c=this.getContainer();return c==null?null:c.getActor();} function getPassive(){local c=this.getContainer();return c==null?null:c.getSkillByID(::$bvvar{namespace}.getValkyrieSkillRuntimeID("feixue_everfrost_dominion"));} function state(){local c=this.getContainer();return c==null?null:c.getSkillByID("$bvvar{modId}.effects.feixue_foreclaimed_self");} function snow(){local c=this.getContainer();return c==null?null:c.getSkillByID("$bvvar{modId}.effects.feixue_snowforged_blade");}
	function hasMeleeWeapon(){local a=this.owner();if(a==null)return false;local w=null;try{w=a.getItems().getItemAtSlot(this.Const.ItemSlot.Mainhand);}catch(e){}return w!=null&&w.isItemType(this.Const.Items.ItemType.MeleeWeapon);}
	function targets( _user )
	{
		return _user == null ? [] : ::$bvvar{namespace}.getValkyrieEnemyTargetsOnTiles(_user, ::$bvvar{namespace}.getValkyrieRadiusTiles(_user.getTile(), 2, true));
	}
	function isUsable(){local s=this.snow();return this.skill.isUsable()&&this.state()!=null&&this.hasMeleeWeapon()&&s!=null&&s.getCount()>0&&this.targets(this.owner()).len()>0;}
	function onUse(_user,_target){if(_user==null||!this.isUsable())return false;local snow=this.snow();local count=snow.getCount();local targets=this.targets(_user);if(targets.len()==0)return false;foreach(target in targets){local result=::$bvvar{namespace}.applyValkyrieWeaponAttack(_user,this,target,{WeaponDamageMult=1.0+0.5*count,ArmorDamageMult=1.25,DirectDamageAdd=0.10*count,HitChance=25,IgnoreDistance=true,IgnoreShield=true,Source="direct"});if(result!=null&&"Hit" in result&&result.Hit&&!::$bvvar{namespace}.isActorDeadOrDying(target))::$bvvar{namespace}.applyValkyrieFixedHitpointDamage(_user,this,target,10*count);if("playValkyrieHitVisual" in ::$bvvar{namespace})::$bvvar{namespace}.playValkyrieHitVisual(this,target,"feixue_iai",result);}local p=this.getPassive();if(p!=null)p.leaveForeclaimed();return true;}
	function getTooltip(){local ret=[{id=1,type="title",text=this.getName()},{id=2,type="description",text=this.getDescription()},{id=3,type="text",text=this.getCostString()},{id=4,type="text",icon="ui/icons/regular_damage.png",text="$bv{skill.feixue_blade_liberation.tooltip.damage}"},{id=5,type="text",icon="ui/icons/direct_damage.png",text="$bv{skill.feixue_blade_liberation.tooltip.fixed}"}];if(!this.isUsable())ret.push({id=6,type="text",icon="ui/tooltips/warning.png",text="$bv{skill.feixue_blade_liberation.tooltip.not_ready}"});return ret;}
});
