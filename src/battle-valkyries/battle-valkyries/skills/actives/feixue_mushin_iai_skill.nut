this.feixue_mushin_iai_skill <- this.inherit("$bvvar{privateFolder}/skills/core/valkyrie_active_skill", {
	function create(){this.valkyrie_active_skill.create();this.m.IsTargeted=true;this.m.IsTargetingActor=true;this.m.IsAttack=true;this.m.IsWeaponSkill=false;this.m.IsRanged=false;this.m.ActionPointCost=3;this.m.FatigueCost=15;this.m.MinRange=1;this.m.MaxRange=3;this.m.MaxRangeBonus=0;}
	function owner(){local c=this.getContainer();return c==null?null:c.getActor();} function getPassive(){local c=this.getContainer();return c==null?null:c.getSkillByID(::$bvvar{namespace}.getValkyrieSkillRuntimeID("feixue_everfrost_dominion"));} function state(){local c=this.getContainer();return c==null?null:c.getSkillByID("$bvvar{modId}.effects.feixue_foreclaimed_self");} function charges(){local c=this.getContainer();return c==null?null:c.getSkillByID("$bvvar{modId}.effects.feixue_frostharden_iai");}
	function hasMeleeWeapon(){local a=this.owner();if(a==null)return false;local w=null;try{w=a.getItems().getItemAtSlot(this.Const.ItemSlot.Mainhand);}catch(e){}return w!=null&&w.isItemType(this.Const.Items.ItemType.MeleeWeapon);}
	function isUsable(){local c=this.charges();return this.skill.isUsable()&&this.state()!=null&&this.hasMeleeWeapon()&&c!=null&&c.getCount()>0;}
	function onVerifyTarget(_origin,_target){if(!this.skill.onVerifyTarget(_origin,_target)||_target==null||!_target.IsOccupiedByActor)return false;local a=this.owner();local t=_target.getEntity();return ::$bvvar{namespace}.isEligibleValkyrieEnemyTarget(a,t,this.m.MaxRange,true)&&a.getTile().getDistanceTo(t.getTile())>=this.m.MinRange;}
	function onUse(_user,_target){if(_user==null||!this.isUsable()||!this.onVerifyTarget(_user.getTile(),_target))return false;local charges=this.charges();if(charges==null||!charges.consumeCount(1))return false;local target=_target.getEntity();local result=::$bvvar{namespace}.applyValkyrieWeaponAttack(_user,this,target,{WeaponDamageMult=1.10,ArmorDamageMult=1.25,DirectDamageAdd=0.20,HitChance=25,IgnoreDistance=true,IgnoreShield=true,Source="direct"});local p=this.getPassive();if(p!=null)p.grantIaiResolution(target,result!=null&&"Hit" in result&&result.Hit);if("playValkyrieHitVisual" in ::$bvvar{namespace})::$bvvar{namespace}.playValkyrieHitVisual(this,target,"feixue_iai",result);return true;}
	function getTooltip(){local ret=[{id=1,type="title",text=this.getName()},{id=2,type="description",text=this.getDescription()},{id=3,type="text",text=this.getCostString()},{id=4,type="text",icon="ui/icons/hitchance.png",text="$bv{skill.feixue_mushin_iai.tooltip.hit}"},{id=5,type="text",icon="ui/icons/regular_damage.png",text="$bv{skill.feixue_mushin_iai.tooltip.damage}"},{id=6,type="text",icon="ui/icons/special.png",text="$bv{skill.feixue_mushin_iai.tooltip.state}"}];if(!this.isUsable())ret.push({id=7,type="text",icon="ui/tooltips/warning.png",text="$bv{skill.feixue_mushin_iai.tooltip.not_ready}"});return ret;}
});
