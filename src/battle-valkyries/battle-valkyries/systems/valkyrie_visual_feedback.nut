::$bvvar{namespace}.logValkyrieVisualDebug <- function( _message )
{
	try { ::logInfo("[Battle Valkyries] [HimekoVisual] " + _message); } catch (e) {}
};

::$bvvar{namespace}.playValkyrieVisual <- function( _context, _target, _theme, _options = null )
{
	local themeName = typeof _theme == "string" ? _theme : "table";
	local isHimekoTheme = themeName == "himeko_owner_ring" || themeName == "himeko_target_lock" || themeName == "himeko_orbital" || themeName == "himeko_followup_cast";
	local targetID = "null";
	try { targetID = _target == null ? "null" : ::$bvvar{namespace}.getValkyrieCombatObjectID(_target); } catch (idError) {}
	try
	{
		if (_context == null || _target == null || _theme == null)
		{
			if (isHimekoTheme) ::$bvvar{namespace}.logValkyrieVisualDebug("stage=invalid-input theme=" + themeName + " target=" + targetID);
			return false;
		}

		if (typeof _theme == "string")
		{
			if (!(_theme in ::$bvvar{namespace}.ValkyrieVisualThemes))
			{
				if (isHimekoTheme) ::$bvvar{namespace}.logValkyrieVisualDebug("stage=theme-missing theme=" + themeName + " target=" + targetID);
				return false;
			}

			_theme = ::$bvvar{namespace}.ValkyrieVisualThemes[_theme];
		}

		// A TargetResolved event may arrive after the target's death routine has
		// already detached it from the tactical map.  Such actors can still expose
		// a stale tile object, but passing that object to the native renderer can
		// terminate the process before Squirrel's try/catch gets control back.
		if ("isActorDeadOrDying" in ::$bvvar{namespace})
		{
			try
			{
				if (::$bvvar{namespace}.isActorDeadOrDying(_target))
				{
					if (isHimekoTheme) ::$bvvar{namespace}.logValkyrieVisualDebug("stage=target-dead theme=" + themeName + " target=" + targetID);
					return false;
				}
			}
			catch (deadStateError) {}
		}

		local hasPlacementAPI = false;
		local isPlacedOnMap = true;
		try
		{
			hasPlacementAPI = "isPlacedOnMap" in _target && typeof _target.isPlacedOnMap == "function";
			if (hasPlacementAPI) isPlacedOnMap = _target.isPlacedOnMap();
		}
		catch (placementError)
		{
			return false;
		}
		if (hasPlacementAPI && !isPlacedOnMap)
		{
			if (isHimekoTheme) ::$bvvar{namespace}.logValkyrieVisualDebug("stage=target-detached theme=" + themeName + " target=" + targetID);
			return false;
		}

		// Tactical and createColor are environment members on production skill
		// instances, not necessarily own table slots. Calling them directly is
		// the same reliable path used by vanilla skills and Liuying's visuals.
		local tile = _target.getTile();
		local tactical = null;
		try { tactical = _context.Tactical; } catch (contextTacticalError) {}
		if (tactical == null)
		{
			try { tactical = ::Tactical; } catch (globalTacticalError) {}
		}
		if (tile == null || tactical == null)
		{
			if (isHimekoTheme) ::$bvvar{namespace}.logValkyrieVisualDebug("stage=context-unavailable theme=" + themeName + " target=" + targetID + " tile=" + (tile != null) + " tactical=" + (tactical != null));
			return false;
		}

		local effect = _options != null && "Effect" in _options ? _options.Effect : ("Effect" in _theme ? _theme.Effect : "effect_lightning_02");
		local effects = _options != null && "Effects" in _options ? _options.Effects : ("Effects" in _theme ? _theme.Effects : null);
		local color = _options != null && "Color" in _options ? _options.Color : ("Color" in _theme ? _theme.Color : "#ffffff");
		local scale = _options != null && "Scale" in _options ? _options.Scale : ("Scale" in _theme ? _theme.Scale : 1.0);
		local endScale = _options != null && "EndScale" in _options ? _options.EndScale : ("EndScale" in _theme ? _theme.EndScale : 0.25);
		local scaleStep = _options != null && "ScaleStep" in _options ? _options.ScaleStep : ("ScaleStep" in _theme ? _theme.ScaleStep : 0.08);
		local endScaleStep = _options != null && "EndScaleStep" in _options ? _options.EndScaleStep : ("EndScaleStep" in _theme ? _theme.EndScaleStep : 0.0);
		local duration = _options != null && "Duration" in _options ? _options.Duration : ("Duration" in _theme ? _theme.Duration : 200);
		local layers = _options != null && "Layers" in _options ? _options.Layers : ("Layers" in _theme ? _theme.Layers : 1);
		local delayStep = _options != null && "DelayStep" in _options ? _options.DelayStep : ("DelayStep" in _theme ? _theme.DelayStep : 35);
		local offsets = _options != null && "Offsets" in _options ? _options.Offsets : ("Offsets" in _theme ? _theme.Offsets : null);
		local visualColor = null;
		local hasVisualColor = false;
		try { visualColor = _context.createColor(color); hasVisualColor = true; } catch (contextColorError) {}
		if (!hasVisualColor)
		{
			try { visualColor = ::createColor(color); hasVisualColor = true; } catch (globalColorError) {}
		}
		if (!hasVisualColor)
		{
			if (isHimekoTheme) ::$bvvar{namespace}.logValkyrieVisualDebug("stage=color-unavailable theme=" + themeName + " target=" + targetID);
			return false;
		}

		scale = ::Math.max(0.1, scale);
		endScale = ::Math.max(0.1, endScale);
		scaleStep = ::Math.max(0.0, scaleStep);
		endScaleStep = ::Math.max(0.0, endScaleStep);
		duration = ::Math.max(50, duration);
		layers = ::Math.max(1, ::Math.min(4, layers));
		delayStep = ::Math.max(0, delayStep);

		for (local i = 0; i < layers; ++i)
		{
			local layerEffect = effect;
			if (effects != null && typeof effects == "array" && effects.len() > 0)
			{
				layerEffect = effects[i % effects.len()];
			}
			local offsetX = 0;
			local offsetY = 45;
			if (offsets != null && typeof offsets == "array" && offsets.len() > 0)
			{
				local offset = offsets[i % offsets.len()];
				if (offset != null && typeof offset == "table")
				{
					offsetX = "X" in offset ? offset.X : offsetX;
					offsetY = "Y" in offset ? offset.Y : offsetY;
				}
			}
			tactical.spawnSpriteEffect(layerEffect, visualColor, tile, offsetX, offsetY, scale + i * scaleStep, endScale + i * endScaleStep, i * delayStep, duration, 300);
		}
		if (isHimekoTheme) ::$bvvar{namespace}.logValkyrieVisualDebug("stage=spawned theme=" + themeName + " brush=" + effect + " target=" + targetID + " layers=" + layers + " duration=" + duration);

		return true;
	}
	catch (e)
	{
		if (isHimekoTheme)
		{
			::$bvvar{namespace}.logValkyrieVisualDebug("stage=exception theme=" + themeName + " target=" + targetID + " reason=" + e);
		}
		return false;
	}
};

::$bvvar{namespace}.playValkyrieHitVisual <- function( _context, _target, _theme, _result, _options = null )
{
	try
	{
		if (_result == null || !("Applied" in _result) || !_result.Applied || !("Hit" in _result) || !_result.Hit)
		{
			return false;
		}

		return ::$bvvar{namespace}.playValkyrieVisual(_context, _target, _theme, _options);
	}
	catch (e)
	{
		return false;
	}
};
