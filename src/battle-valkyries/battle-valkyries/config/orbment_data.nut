local bv = ::$bvvar{namespace};
bv.OrbmentElements <- ["earth", "water", "fire", "wind", "time", "space", "mirage"];
bv.OrbmentForms <- { starrail = { Name = "$bv{orbment.form.starrail}", Lines = [[0, 1, 2, 3, 4, 5, 6]], ActiveSlots = 3, PassiveCapacity = 3, Icon = "$bvvar{iconPrefix}/orbment_starrail.png" }, twinwing = { Name = "$bv{orbment.form.twinwing}", Lines = [[0, 1, 2, 3], [0, 4, 5, 6]], ActiveSlots = 2, PassiveCapacity = 5, Icon = "$bvvar{iconPrefix}/orbment_twinwing.png" }, triskelion = { Name = "$bv{orbment.form.triskelion}", Lines = [[0, 1, 2], [0, 3, 4], [0, 5, 6]], ActiveSlots = 1, PassiveCapacity = 7, Icon = "$bvvar{iconPrefix}/orbment_triskelion.png" }, star_reader = { Name = "$bv{orbment.form.star_reader}", Lines = [[0, 1, 2, 3, 4, 5, 6]], ActiveSlots = 3, PassiveCapacity = 3, Icon = "$bvvar{iconPrefix}/tio_star_reader_orbment.png" } };
bv.OrbmentGems <- { rockheart = { Name = "$bv{orbment.gem.rockheart}", Elements1 = { earth = 2 }, Elements2 = { earth = 3 }, Bonus = "MeleeDefense", Value1 = 1, Value2 = 2, Icon = "$bvvar{iconPrefix}/orbment_gem_rockheart.png" }, clearflow = { Name = "$bv{orbment.gem.clearflow}", Elements1 = { water = 2 }, Elements2 = { water = 3 }, Bonus = "Hitpoints", Value1 = 3, Value2 = 5, Icon = "$bvvar{iconPrefix}/orbment_gem_clearflow.png" }, redblade = { Name = "$bv{orbment.gem.redblade}", Elements1 = { fire = 2 }, Elements2 = { fire = 3 }, Bonus = "Damage", Value1 = 0.02, Value2 = 0.03, Icon = "$bvvar{iconPrefix}/orbment_gem_redblade.png" }, swiftwind = { Name = "$bv{orbment.gem.swiftwind}", Elements1 = { wind = 2 }, Elements2 = { wind = 3 }, Bonus = "Initiative", Value1 = 3, Value2 = 5, Icon = "$bvvar{iconPrefix}/orbment_gem_swiftwind.png" }, timesand = { Name = "$bv{orbment.gem.timesand}", Elements1 = { time = 2 }, Elements2 = { time = 3 }, Bonus = "Stamina", Value1 = 3, Value2 = 5, Icon = "$bvvar{iconPrefix}/orbment_gem_timesand.png" }, brightsky = { Name = "$bv{orbment.gem.brightsky}", Elements1 = { space = 2 }, Elements2 = { space = 3 }, Bonus = "RangedDefense", Value1 = 1, Value2 = 2, Icon = "$bvvar{iconPrefix}/orbment_gem_brightsky.png" }, phantomeye = { Name = "$bv{orbment.gem.phantomeye}", Elements1 = { mirage = 2 }, Elements2 = { mirage = 3 }, Bonus = "Bravery", Value1 = 2, Value2 = 3, Icon = "$bvvar{iconPrefix}/orbment_gem_phantomeye.png" }, irontrace = { Name = "$bv{orbment.gem.irontrace}", Elements1 = { earth = 1, fire = 1 }, Elements2 = { earth = 2, fire = 1 }, Bonus = "Pierce", Value1 = 0.01, Value2 = 0.02, Icon = "$bvvar{iconPrefix}/orbment_gem_irontrace.png" }, boilflow = { Name = "$bv{orbment.gem.boilflow}", Elements1 = { fire = 1, water = 1 }, Elements2 = { fire = 2, water = 1 }, Bonus = "Damage", Value1 = 0.01, Value2 = 0.02, Icon = "$bvvar{iconPrefix}/orbment_gem_boilflow.png" }, rainfeather = { Name = "$bv{orbment.gem.rainfeather}", Elements1 = { water = 1, wind = 1 }, Elements2 = { water = 2, wind = 1 }, Bonus = "Hitpoints", Value1 = 2, Value2 = 3, Icon = "$bvvar{iconPrefix}/orbment_gem_rainfeather.png" }, swiftshade = { Name = "$bv{orbment.gem.swiftshade}", Elements1 = { wind = 1, time = 1 }, Elements2 = { wind = 2, time = 1 }, Bonus = "Initiative", Value1 = 2, Value2 = 3, Icon = "$bvvar{iconPrefix}/orbment_gem_swiftshade.png" }, starcut = { Name = "$bv{orbment.gem.starcut}", Elements1 = { time = 1, space = 1 }, Elements2 = { time = 2, space = 1 }, Bonus = "Stamina", Value1 = 2, Value2 = 3, Icon = "$bvvar{iconPrefix}/orbment_gem_starcut.png" }, mirrorlight = { Name = "$bv{orbment.gem.mirrorlight}", Elements1 = { space = 1, mirage = 1 }, Elements2 = { space = 2, mirage = 1 }, Bonus = "RangedSkill", Value1 = 1, Value2 = 2, Icon = "$bvvar{iconPrefix}/orbment_gem_mirrorlight.png" }, duskmarl = { Name = "$bv{orbment.gem.duskmarl}", Elements1 = { mirage = 1, earth = 1 }, Elements2 = { mirage = 2, earth = 1 }, Bonus = "Reduction", Value1 = 0.01, Value2 = 0.02, Icon = "$bvvar{iconPrefix}/orbment_gem_duskmarl.png" } };
bv.OrbmentRecipes <- { orbment_stonewall = { Name = "$bv{skill.orbment_stonewall.name}", Description = "$bv{skill.orbment_stonewall.description}", Requirements = { earth = 3 }, Kind = "passive", Cost = 1, Bonus = { MeleeDefense = 5 } }, orbment_vitality = { Name = "$bv{skill.orbment_vitality.name}", Description = "$bv{skill.orbment_vitality.description}", Requirements = { water = 3 }, Kind = "passive", Cost = 1, Bonus = { Hitpoints = 15 } }, orbment_onslaught = { Name = "$bv{skill.orbment_onslaught.name}", Description = "$bv{skill.orbment_onslaught.description}", Requirements = { fire = 3 }, Kind = "passive", Cost = 1, Bonus = { Damage = 0.08 } }, orbment_swiftness = { Name = "$bv{skill.orbment_swiftness.name}", Description = "$bv{skill.orbment_swiftness.description}", Requirements = { wind = 3 }, Kind = "passive", Cost = 1, Bonus = { Initiative = 15 } }, orbment_breathing = { Name = "$bv{skill.orbment_breathing.name}", Description = "$bv{skill.orbment_breathing.description}", Requirements = { time = 3 }, Kind = "passive", Cost = 1, Bonus = { Recovery = 2 } }, orbment_far_guard = { Name = "$bv{skill.orbment_far_guard.name}", Description = "$bv{skill.orbment_far_guard.description}", Requirements = { space = 3 }, Kind = "passive", Cost = 1, Bonus = { RangedDefense = 5 } }, orbment_composure = { Name = "$bv{skill.orbment_composure.name}", Description = "$bv{skill.orbment_composure.description}", Requirements = { mirage = 3 }, Kind = "passive", Cost = 1, Bonus = { Bravery = 10 } }, orbment_piercing = { Name = "$bv{skill.orbment_piercing.name}", Description = "$bv{skill.orbment_piercing.description}", Requirements = { fire = 5, space = 3 }, Kind = "passive", Cost = 2, Bonus = { Pierce = 0.15 } }, orbment_shatter = { Name = "$bv{skill.orbment_shatter.name}", Description = "$bv{skill.orbment_shatter.description}", Requirements = { fire = 5, earth = 3 }, Kind = "passive", Cost = 2, Bonus = { Armor = 0.2 } }, orbment_citadel = { Name = "$bv{skill.orbment_citadel.name}", Description = "$bv{skill.orbment_citadel.description}", Requirements = { earth = 5, water = 3 }, Kind = "passive", Cost = 2, Bonus = { Reduction = 0.1 } }, orbment_circulation = { Name = "$bv{skill.orbment_circulation.name}", Description = "$bv{skill.orbment_circulation.description}", Requirements = { water = 3, time = 5 }, Kind = "passive", Cost = 2, Bonus = { FatigueMult = 0.9 } }, orbment_insight = { Name = "$bv{skill.orbment_insight.name}", Description = "$bv{skill.orbment_insight.description}", Requirements = { wind = 5, mirage = 3 }, Kind = "passive", Cost = 2, Bonus = { MeleeSkill = 8, RangedSkill = 8 } }, orbment_unyielding = { Name = "$bv{skill.orbment_unyielding.name}", Description = "$bv{skill.orbment_unyielding.description}", Requirements = { mirage = 5, earth = 3 }, Kind = "passive", Cost = 2, Bonus = { Bravery = 15, Stamina = 10 } }, orbment_battle_return = { Name = "$bv{skill.orbment_battle_return.name}", Description = "$bv{skill.orbment_battle_return.description}", Requirements = { space = 5, time = 3 }, Kind = "passive", Cost = 2, Bonus = { KillRecovery = 4 } }, orbment_stone_lance = { Name = "$bv{skill.orbment_stone_lance.name}", Description = "$bv{skill.orbment_stone_lance.description}", Requirements = { earth = 3 }, Kind = "active", Cost = 1 }, orbment_healing_drop = { Name = "$bv{skill.orbment_healing_drop.name}", Description = "$bv{skill.orbment_healing_drop.description}", Requirements = { water = 3 }, Kind = "active", Cost = 1 }, orbment_fire_bolt = { Name = "$bv{skill.orbment_fire_bolt.name}", Description = "$bv{skill.orbment_fire_bolt.description}", Requirements = { fire = 3 }, Kind = "active", Cost = 1 }, orbment_wind_blade = { Name = "$bv{skill.orbment_wind_blade.name}", Description = "$bv{skill.orbment_wind_blade.description}", Requirements = { wind = 3 }, Kind = "active", Cost = 1 }, orbment_temporal_boost = { Name = "$bv{skill.orbment_temporal_boost.name}", Description = "$bv{skill.orbment_temporal_boost.description}", Requirements = { time = 3 }, Kind = "active", Cost = 1 }, orbment_space_barrier = { Name = "$bv{skill.orbment_space_barrier.name}", Description = "$bv{skill.orbment_space_barrier.description}", Requirements = { space = 3 }, Kind = "active", Cost = 1 }, orbment_phantom_noise = { Name = "$bv{skill.orbment_phantom_noise.name}", Description = "$bv{skill.orbment_phantom_noise.description}", Requirements = { mirage = 3 }, Kind = "active", Cost = 1 }, orbment_rock_bulwark = { Name = "$bv{skill.orbment_rock_bulwark.name}", Description = "$bv{skill.orbment_rock_bulwark.description}", Requirements = { earth = 6, water = 3 }, Kind = "active", Cost = 1 }, orbment_spring_prayer = { Name = "$bv{skill.orbment_spring_prayer.name}", Description = "$bv{skill.orbment_spring_prayer.description}", Requirements = { water = 6, space = 3 }, Kind = "active", Cost = 1 }, orbment_flame_gale = { Name = "$bv{skill.orbment_flame_gale.name}", Description = "$bv{skill.orbment_flame_gale.description}", Requirements = { fire = 6, wind = 3 }, Kind = "active", Cost = 1 }, orbment_gale_slash = { Name = "$bv{skill.orbment_gale_slash.name}", Description = "$bv{skill.orbment_gale_slash.description}", Requirements = { fire = 4, wind = 3 }, Kind = "active", Cost = 1 }, orbment_temporal_haste = { Name = "$bv{skill.orbment_temporal_haste.name}", Description = "$bv{skill.orbment_temporal_haste.description}", Requirements = { time = 6, wind = 3 }, Kind = "active", Cost = 1 }, orbment_warp = { Name = "$bv{skill.orbment_warp.name}", Description = "$bv{skill.orbment_warp.description}", Requirements = { space = 6, mirage = 3 }, Kind = "active", Cost = 1 }, orbment_phantom_veil = { Name = "$bv{skill.orbment_phantom_veil.name}", Description = "$bv{skill.orbment_phantom_veil.description}", Requirements = { mirage = 6, time = 3 }, Kind = "active", Cost = 1 } };

bv.OrbmentGemOrder <- ["rockheart", "clearflow", "redblade", "swiftwind", "timesand", "brightsky", "phantomeye", "irontrace", "boilflow", "rainfeather", "swiftshade", "starcut", "mirrorlight", "duskmarl"];
