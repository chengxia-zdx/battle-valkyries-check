::$bvvar{namespace}.getValkyrieTraitData <- function( _valkyrieID )
{
	if (typeof _valkyrieID != "string" || _valkyrieID.len() == 0 || !(_valkyrieID in ::$bvvar{namespace}.ValkyrieTraitData))
	{
		return null;
	}

	return ::$bvvar{namespace}.ValkyrieTraitData[_valkyrieID];
};
