this.himeko_trailblazer_hangar_camp_location <- this.inherit("scripts/entity/world/locations/battle_valkyries/himeko_bond_camp_base", {
	function getBondStage() { return 80; }
	function getLocationName() { return "$bv{location.himeko_bond.80.name}"; }
	function getLocationDescription() { return "$bv{location.himeko_bond.80.description}"; }
	function getWorldBrush() { return "world_orc_camp_01"; }
});
