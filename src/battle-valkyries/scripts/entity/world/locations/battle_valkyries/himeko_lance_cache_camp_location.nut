this.himeko_lance_cache_camp_location <- this.inherit("scripts/entity/world/locations/battle_valkyries/himeko_bond_camp_base", {
	function getBondStage() { return 20; }
	function getLocationName() { return "$bv{location.himeko_bond.20.name}"; }
	function getLocationDescription() { return "$bv{location.himeko_bond.20.description}"; }
	function getWorldBrush() { return "world_bandit_camp_01"; }
});
