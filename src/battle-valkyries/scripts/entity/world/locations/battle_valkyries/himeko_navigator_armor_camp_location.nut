this.himeko_navigator_armor_camp_location <- this.inherit("scripts/entity/world/locations/battle_valkyries/himeko_bond_camp_base", {
	function getBondStage() { return 60; }
	function getLocationName() { return "$bv{location.himeko_bond.60.name}"; }
	function getLocationDescription() { return "$bv{location.himeko_bond.60.description}"; }
	function getWorldBrush() { return "world_vampire_coven"; }
});
