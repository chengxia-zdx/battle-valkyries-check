this.himeko_star_circlet_camp_location <- this.inherit("scripts/entity/world/locations/battle_valkyries/himeko_bond_camp_base", {
	function getBondStage() { return 40; }
	function getLocationName() { return "$bv{location.himeko_bond.40.name}"; }
	function getLocationDescription() { return "$bv{location.himeko_bond.40.description}"; }
	function getWorldBrush() { return "world_goblin_camp_01"; }
});
