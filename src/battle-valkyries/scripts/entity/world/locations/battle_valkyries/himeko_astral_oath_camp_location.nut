this.himeko_astral_oath_camp_location <- this.inherit("scripts/entity/world/locations/battle_valkyries/himeko_bond_camp_base", {
	function getBondStage() { return 100; }
	function getLocationName() { return "$bv{location.himeko_bond.100.name}"; }
	function getLocationDescription() { return "$bv{location.himeko_bond.100.description}"; }
	function getWorldBrush() { return "world_vampire_coven"; }
});
